# Copiez ce fichier vers .env, puis remplacez toutes les valeurs d’exemple.
# Ne commitez jamais backend/.env.
MONGO_URL=mongodb://mongo:27017
DB_NAME=golden_pirates

# Générer au moins 32 caractères aléatoires : openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters

# Compte créé uniquement si aucun administrateur n'existe encore.
# Le démarrage ne modifie jamais le mot de passe d'un compte existant.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-long-password

# URL publique exacte de l'interface et liste explicite de ses origines autorisées.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# false en HTTP local ; true obligatoire pour toute URL HTTPS publique.
COOKIE_SECURE=false
# true seulement derrière un proxy/ingress qui réécrit et assainit X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# Secret dédié au cron d'entretien. Configurez-le dans l'hébergeur, jamais dans Git.
WEBHOOK_CRON_SECRET=replace-with-a-different-random-secret
# Optionnel : URL officielle de dons PayPal.
PAYPAL_DONATION_URL=
